{
	"name": "fmi-web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.19.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . && biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test:e2e": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/ms-playwright playwright test",
		"test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/ms-playwright playwright test --ui",
		"test:e2e:debug": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/ms-playwright playwright test --debug",
		"test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/ms-playwright playwright install chromium"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@radix-ui/react-slot": "^1.2.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.544.0",
		"motion": "^13.1.1",
		"next": "^16.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.86.0",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.1.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"eslint": "^9.0.0",
		"eslint-config-next": "^16.0.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.9.0"
	}
}
